[configuration]

entry_symbol = "chunkio_library_init"
compatibility_minimum = "4.5"

[libraries]

linux.debug.x86_64 = "res://bin/libchunkio.so"
linux.release.x86_64 = "res://bin/libchunkio.so"
windows.debug.x86_64 = "res://bin/libchunkio.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://bin/libchunkio.windows.template_release.x86_64.dll"
