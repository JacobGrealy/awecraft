[connection signal="pressed" from="Layer/PauseBox/Center/VBox/QuitButton" to="." method="_on_quit_btn_pressed"]
[connection signal="value_changed" from="Layer/OptionsBox/Center/VBox/RenderRow/RenderSlider" to="." method="_on_render_changed"]
[connection signal="value_changed" from="Layer/OptionsBox/Center/VBox/SimRow/SimSlider" to="." method="_on_sim_changed"]
